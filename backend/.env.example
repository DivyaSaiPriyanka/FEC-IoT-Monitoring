# Copy this file to backend/.env and adjust as needed.

PORT=8000
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=sqlite:///fec_data.db
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_LOG_LEVEL=info

# Set to "true" only for quick local/demo runs without a separate
# worker process (see readme.txt, Option B).
RUN_WORKER_INLINE=false
