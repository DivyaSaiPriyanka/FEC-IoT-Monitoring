[Unit]
Description=FEC Backend - Queue worker instance %i
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/fec_project/backend
EnvironmentFile=/opt/fec_project/backend/.env
Environment=WORKER_ID=%i
ExecStart=/opt/fec_project/backend/venv/bin/python worker.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
